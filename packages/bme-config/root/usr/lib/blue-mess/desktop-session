#!/usr/bin/ash
# Openbox and its desktop companions share one private session bus.
set -eu
export XDG_CURRENT_DESKTOP=Openbox
export XDG_SESSION_DESKTOP=bluemess
export DESKTOP_SESSION=bluemess
if [ "${1:-}" != --session-bus ]; then
    # Standard exports; never copy or rewrite individual Flatpak launchers.
    export XDG_DATA_DIRS="${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    state=${XDG_STATE_HOME:-$HOME/.local/state}/blue-mess
    mkdir -p "$state"
    exec > "$state/desktop.log" 2>&1
    exec dbus-run-session -- "$0" --session-bus
fi
# Keep diagnostics available even when a desktop starts with session problems.
bluemess-session-check || :
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
export XDG_CONFIG_HOME="$config_home"
# Seed only missing XFCE files, including for users of an earlier alpha.
source=/usr/share/blue-mess/skel/.config/xfce4
for relative in helpers.rc xfconf/xfce-perchannel-xml/xsettings.xml xfconf/xfce-perchannel-xml/xfce4-panel.xml xfconf/xfce-perchannel-xml/xfce4-power-manager.xml xfconf/xfce-perchannel-xml/xfce4-terminal.xml panel/launcher-1/terminal.desktop; do
    # Let Terminal migrate an existing legacy configuration into Xfconf.
    if [ "$relative" = xfconf/xfce-perchannel-xml/xfce4-terminal.xml ] &&
        { [ -e "$config_home/xfce4/terminal/terminalrc" ] || [ -e "$config_home/Terminal/terminalrc" ]; }; then
        continue
    fi
    target=$config_home/xfce4/$relative
    if [ ! -e "$target" ]; then
        mkdir -p "${target%/*}"
        cp "$source/$relative" "$target"
    fi
done
xsetroot -solid '#174b88'
xset s off
xset s noblank
# Some X servers have no DPMS extension; screensaver settings still apply.
xset -dpms 2>/dev/null || :
children=
cleanup() {
    trap - EXIT HUP INT TERM
    for pid in $children; do kill "$pid" 2>/dev/null || :; done
    for pid in $children; do wait "$pid" 2>/dev/null || :; done
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' HUP TERM
xdg-user-dirs-update
xfsettingsd --no-daemon &
children="$children $!"
nm-applet &
children="$children $!"
bluemess-audio run &
children="$children $!"
xfce4-panel --disable-wm-check &
children="$children $!"
xfce4-power-manager --no-daemon &
children="$children $!"
lxpolkit &
children="$children $!"
openbox &
window_manager=$!
children="$children $window_manager"
wait "$window_manager"
