<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse></focus>
  <theme><name>Clearlooks</name><titleLayout>NLIMC</titleLayout></theme>
  <desktops><number>2</number><firstdesk>1</firstdesk></desktops>
  <keyboard>
    <keybind key="C-A-t"><action name="Execute"><command>xterm -ls -e /usr/bin/ash</command></action></keybind>
    <keybind key="W-Return"><action name="Execute"><command>xterm -ls -e /usr/bin/ash</command></action></keybind>
    <keybind key="A-Tab"><action name="NextWindow"/></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow"/></keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
    <keybind key="W-space"><action name="ShowMenu"><menu>root-menu</menu></action></keybind>
    <keybind key="W-d"><action name="ToggleShowDesktop"/></keybind>
    <keybind key="W-Left"><action name="DesktopLeft"/></keybind>
    <keybind key="W-Right"><action name="DesktopRight"/></keybind>
  </keyboard>
  <mouse><context name="Root"><mousebind button="Right" action="Press"><action name="ShowMenu"><menu>root-menu</menu></action></mousebind></context></mouse>
  <menu><file>menu.xml</file></menu>
</openbox_config>
