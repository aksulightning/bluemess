#!/sbin/openrc-run
# Native OpenRC service. Debian LSB compatibility metadata is kept separately
# in /etc/insserv/overrides so lsb2rcconf cannot misclassify this script.
description="Network time synchronization"
command=/usr/sbin/chronyd
command_args="-n -F 1"
supervisor=supervise-daemon
output_logger="exec /usr/bin/busybox logger -t chrony"
error_logger="exec /usr/bin/busybox logger -t chrony"
pidfile=/run/bme-chrony.pid
depend() { need bme-boot bme-syslog; use bme-network network-manager; }
start_pre() { mkdir -p /run/chrony; chown _chrony:_chrony /run/chrony; }
