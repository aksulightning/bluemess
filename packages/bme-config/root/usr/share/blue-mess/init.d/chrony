#!/sbin/openrc-run
### BEGIN INIT INFO
# Provides:          chrony
# Required-Start:
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Blue Mess native OpenRC chrony service
### END INIT INFO
# LSB metadata preserves Debian package helper compatibility. Native OpenRC
# ordering is specified by depend() below.
description="Network time synchronization"
command=/usr/sbin/chronyd
command_args="-n -F 1"
supervisor=supervise-daemon
pidfile=/run/bme-chrony.pid
depend() { need bme-boot; use bme-network; }
start_pre() { mkdir -p /run/chrony; chown _chrony:_chrony /run/chrony; }
