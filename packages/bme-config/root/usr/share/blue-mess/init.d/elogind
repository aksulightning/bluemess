#!/sbin/openrc-run
### BEGIN INIT INFO
# Provides:          elogind
# Required-Start:
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Blue Mess native OpenRC elogind service
### END INIT INFO
# LSB metadata preserves Debian package helper compatibility. Native OpenRC
# ordering is specified by depend() below.
description="Login and seat management"
command=/usr/libexec/elogind/elogind
supervisor=supervise-daemon
pidfile=/run/bme-elogind.pid
depend() { need dbus udev bme-boot; before bme-getty.tty1 bme-getty.ttyS0; }
start_pre() {
    [ -x "$command" ] || command=/usr/lib/elogind/elogind
    [ -x "$command" ] || command=/usr/sbin/elogind
    mkdir -p /run/elogind
}
