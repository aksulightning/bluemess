#!/sbin/openrc-run
description="Authenticated console login"
supervisor=supervise-daemon
port="${RC_SVCNAME#bme-getty.}"
command=/sbin/agetty
command_args="--noclear ${port} 115200,38400,9600 linux"
pidfile="/run/${RC_SVCNAME}.pid"
respawn_delay=2
depend() { need bme-boot elogind; after bme-network; }
start_pre() {
    # tty4 is diagnostics only. No additional F-key login consoles.
    case "$port" in tty1|tty2|tty3|ttyS0) ;; *) eerror "Login is disabled on $port"; return 1 ;; esac
    if [ "$port" = tty1 ]; then
        . /usr/lib/blue-mess/greeter-common
        greeter_start_allowed agetty || return 1
    fi
    [ -c "/dev/$port" ]
}
start_post() {
    # Kernel/boot diagnostics stay on tty4; the installed text login selects tty1.
    [ "$port" != tty1 ] || /usr/bin/chvt 1
}
