#!/sbin/openrc-run
### BEGIN INIT INFO
# Provides:          udev
# Required-Start:
# Required-Stop:
# Default-Start:     S
# Default-Stop:      
# Short-Description: Blue Mess native OpenRC udev service
### END INIT INFO
# LSB metadata preserves Debian package helper compatibility. Native OpenRC
# ordering is specified by depend() below.
description="Device manager and coldplug"
command=/usr/lib/systemd/systemd-udevd
command_args="--resolve-names=never"
command_background=yes
pidfile=/run/bme-udev.pid
depend() { need bme-root; before bme-localmount; provide dev; }
start_pre() {
    [ -x "$command" ] || command=/usr/lib/udev/udevd
    # initramfs-tools normally stops its udev daemon before switch_root.
    # Preserve one owner if a live initramfs left it running.
    udevadm control --exit >/dev/null 2>&1 || :
    return 0
}
start_post() {
    udevadm trigger --type=subsystems --action=add || return 1
    udevadm trigger --type=devices --action=add || return 1
    udevadm settle --timeout=30
}
